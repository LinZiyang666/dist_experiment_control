#!/bin/sh
# origin: hot-update S6 plan §10.1 / §12.1 P29.
# The service owns peers and socket custody; its caller owns and waits its PID.
# Use serve/call for explicit custody, or the environment-based drill-75 verbs.
flow_fixture() {
    [ "$#" -ge 1 ] || return 2
    case "$1" in
        selftest)
            "${PYTHON3:-python3}" -I -B "$HERE/drills/lib/hot_update_flow_fixture.py" selftest
            ;;
        online)
            "$SIM" ctl -- node ls --json | jq -e '[.nodes[]? | select(.nid=="agt1" and .status=="ONLINE")] | length==1' >/dev/null
            ;;
        prepare)
            [ "$#" = 2 ] && [ -n "${FLOW_EV:-}" ] && [ -n "${FLOW_NONCE:-}" ] || return 2
            [ -z "${FLOW_FIXTURE_JOB:-}" ] || return 2
            "${PYTHON3:-python3}" -I -B "$HERE/drills/lib/hot_update_flow_fixture.py" serve --root "$FLOW_EV" --nonce "$FLOW_NONCE" \
                --profile "$2" --arm "${ARM:?}" --here "$HERE" --sim "$SIM" --instance "${INSTANCE:?}" \
                > "$FLOW_EV/fixture.stdout" 2> "$FLOW_EV/fixture.stderr" &
            FLOW_FIXTURE_JOB=$!
            "${PYTHON3:-python3}" -I -B "$HERE/drills/lib/hot_update_flow_fixture.py" call --root "$FLOW_EV" prepare || return "$?"
            FLOW_OPEN_IP=$(jq -er '.open.ip' "$FLOW_EV/fixture.json") || return 2
            FLOW_OPEN_PORT=$(jq -er '.open.port' "$FLOW_EV/fixture.json") || return 2
            ;;
        cleanup)
            [ -n "${FLOW_FIXTURE_JOB:-}" ] || return 0
            _fff_rc=0
            "${PYTHON3:-python3}" -I -B "$HERE/drills/lib/hot_update_flow_fixture.py" call --root "$FLOW_EV" cleanup || _fff_rc=$?
            _fff_wait_rc=0
            wait "$FLOW_FIXTURE_JOB" || _fff_wait_rc=$?
            [ "$_fff_rc" != 0 ] || _fff_rc=$_fff_wait_rc
            FLOW_FIXTURE_JOB=
            return "$_fff_rc"
            ;;
        start|baseline|open|wait-event|revoke|arm-revoke|checkpoint|finish|collect|continuity|watchdog-fault|broker-mark)
            [ -n "${FLOW_FIXTURE_JOB:-}" ] || return 2
            "${PYTHON3:-python3}" -I -B "$HERE/drills/lib/hot_update_flow_fixture.py" call --root "$FLOW_EV" "$@"
            ;;
        *) return 2 ;;
    esac
}

# Sourcing supplies the 75 protocol; execution supplies the process interface.
case "${0##*/}" in
    flow_fixture)
        _flow_fixture_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
        exec "${PYTHON3:-python3}" -I -B "$_flow_fixture_dir/hot_update_flow_fixture.py" "$@"
        ;;
esac
