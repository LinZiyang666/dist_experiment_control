#!/usr/bin/env bash
# simcluster — Docker simulated-cluster control tool (DEV TOOL; not the tether product).
# Runs on the sim server. Orchestrates docker + in-container systemctl + the REAL tether CLI to
# stand up / grow / break a persistent HA cluster of real-systemd containers, exercising the
# cross-process / nats.conf-drift / install-path bug class the hermetic Go suites cannot reach.
# See docs/reviews/simcluster-plan.md. POSIX-ish bash.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/log.sh
. "$HERE/lib/log.sh"
# shellcheck source=lib/docker.sh
. "$HERE/lib/docker.sh"
# shellcheck source=lib/tether.sh
. "$HERE/lib/tether.sh"
# shellcheck source=lib/secrets.sh
. "$HERE/lib/secrets.sh"

: "${INSTANCE:=sim}"
: "${IMAGE:=tether-sim:dev}"

# --- small helpers (tctl/sctl/leader_node/wait_phase live in lib/tether.sh) -----------------------

# wait_sysd <node> : block until the container's systemd finished booting (running|degraded).
# NB: poll_until runs its predicate in THIS shell (functions like d/ctr_name are visible); a nested
# `sh -c` subshell would NOT see them — that was the first-run bug.
# Ready = systemd is RESPONSIVE (accepts systemctl), not fully booted. `starting` is enough to provision
# + enable units; waiting for `running`/`degraded` can hang >90s on a container with one slow/failed unit
# (e.g. systemd-ask-password-wall.path), even though systemd itself is up. This was the `up` false-fail.
_sysd_ready() {
    case "$(d exec "$(ctr_name "$1")" systemctl is-system-running 2>/dev/null)" in
        running|degraded|starting|maintenance) return 0 ;;
        *) return 1 ;;
    esac
}
wait_sysd() { poll_until 60 2 "systemd responsive on $1" -- _sysd_ready "$1" || die "systemd never came up on $1"; }

role_of() { d inspect -f '{{index .Config.Labels "sim.role"}}' "$(ctr_name "$1")" 2>/dev/null; }

# --- verbs ---------------------------------------------------------------------------------------

cmd_build() {
    [ -x "$HERE/vendor/tether" ] || die "vendor/ not staged — run remote.sh --build (it rsyncs binaries)"
    log "building image $IMAGE from $HERE"
    run d build -t "$IMAGE" "$HERE"
    # M10: verify the baked nats-server against install.sh's SSOT (rsync'd into vendor/), not a literal.
    _want="$(grep -oE 'NATS_SERVER_VERSION[^0-9]*[0-9]+\.[0-9]+\.[0-9]+' "$HERE/vendor/install.sh" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    _got="$(d run --rm "$IMAGE" /usr/local/bin/nats-server --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    log "baked nats-server: ${_got:-unknown} (want ${_want:-?} == install.sh pin)"
    { [ -n "$_want" ] && [ "$_got" = "$_want" ]; } || die "nats-server pin mismatch: baked ${_got:-?} != install.sh ${_want:-?}"
    ok "image $IMAGE built"
}

# provision + boot a single node (used by `up`).
_bring_up_node() {
    _role=$1; _node=$2; shift 2
    if node_exists "$_node"; then
        node_running "$_node" || run d start "$(ctr_name "$_node")" >/dev/null
    else
        log "starting $_role node $_node"
        run_node "$_role" "$_node" "$@"
    fi
    wait_sysd "$_node"
    # sshd for `ssh sim-<node>` (real-ops debug path).
    sctl "$_node" enable --now ssh >/dev/null 2>&1 || true
    log "provisioning $_node ($_role)"
    # retry once — a fresh container can transiently hiccup during install.sh (systemd/dbus/apt state
    # still settling). provision-node.sh is sentinel-guarded + idempotent, so a retry is safe.
    dexec "$_node" -- /opt/sim/provision-node.sh "$_role" "$_node" "$_node" \
        || { warn "provision $_node hiccupped — retrying once"; sleep 2; dexec "$_node" -- /opt/sim/provision-node.sh "$_role" "$_node" "$_node"; }
}

cmd_up() {
    _brokers=1; _agents=0; _ctl=0; _capstore=""
    while [ $# -gt 0 ]; do case "$1" in
        --brokers) _brokers=$2; shift 2;;
        --agents)  _agents=$2;  shift 2;;
        --ctl)     _ctl=$2;     shift 2;;
        --cap-store) _capstore=$2; shift 2;;   # #21: cap broker JS store via a small tmpfs (e.g. 1g)
        *) die "up: unknown arg $1";;
    esac; done
    ensure_net
    # #21 store cap: a size-capped tmpfs at the JS store_dir makes nats-server statfs a small free-disk,
    # so the hardcoded 8 GiB OBJ_xfer bucket reservation overshoots → tier-B is denied (10047). tmpfs
    # (not loopback) consumes no host-global loop devices on the shared box (§9 OQ-5).
    _brk_extra=""
    [ -n "$_capstore" ] && _brk_extra="--tmpfs /var/lib/tether/jetstream:size=$_capstore"
    # shellcheck disable=SC2086
    _i=1; while [ "$_i" -le "$_brokers" ]; do _bring_up_node broker "brk$_i" $_brk_extra; _i=$((_i+1)); done
    _i=1; while [ "$_i" -le "$_agents" ];  do _bring_up_node agent  "agt$_i"; _i=$((_i+1)); done
    _i=1; while [ "$_i" -le "$_ctl" ];     do _bring_up_node ctl    "ctl$_i"; _i=$((_i+1)); done
    ok "up: $_brokers broker(s), $_agents agent(s), $_ctl ctl (instance=$INSTANCE, image=$IMAGE)"
    log "next: ./simcluster init brk1   (standalone → N=1 cluster)"
}

# start a broker's stack (nats-server + tether-broker). Standalone until `init` cuts it over.
cmd_start_broker() {
    _n=${1:?node}
    sctl "$_n" enable --now nats-server
    sctl "$_n" enable --now tether-broker
    ok "started nats-server + tether-broker on $_n"
}

_has_leader() { leader_node >/dev/null 2>&1; }

# _broker_up <node> : predicate — the node's tether-broker is SERVING (answers its admin socket with
# valid status JSON). NB: check for JSON OUTPUT, not the exit code — `cluster status` exits with a
# HEALTH code (1=DEGRADED at N=2, etc.), so a healthy-but-serving broker returns non-zero.
_broker_up() {
    # capture first (|| true) — under `set -o pipefail`, `status`'s health exit code (1=DEGRADED) would
    # make `dexec | jq` return non-zero even when jq matched, wrongly reporting the live broker as down.
    _bu_out=$(dexec -u tether "$1" -- tether cluster status --json 2>/dev/null || true)
    printf '%s' "$_bu_out" | jq -e '(.schema_version != null) or (.leader_id != null)' >/dev/null 2>&1
}

# _reconcile_clustered <node> <own_broker_pub> <account_pub> <peer_triple...> : [workaround #22/#3]
# hand-render <node>'s nats.conf CLUSTERED via `reconcile nats --manual --peer …` (run as ROOT). This is
# the operator doing tether's topology-formation job by hand ONLY because tether can't do it automatically:
# (#22) the in-broker C3 reconciler runs User=tether and is perm-denied writing the root-owned /etc/tether,
# and (#3) `reconcile nats --all` can't harvest route mTLS from a standalone conf on the first grow. We do
# NOT chown the result (Mandate ①): install.sh leaves nats.conf root:root 0644 and nats-server (User=tether)
# reads it fine; chowning masks nothing real — CreateTemp needs the DIRECTORY, which stays root-owned (=#22
# preserved). The rigorous #22 reproduction is drills/13-inbroker-reconcile-perm.sh.
_reconcile_clustered() {
    _rc_node=$1; _rc_brk=$2; _rc_acct=$3; shift 3
    _rc_peers=""
    for _rc_p in "$@"; do _rc_peers="$_rc_peers --peer $_rc_p"; done
    log "grow: [workaround #22/#3] hand-render $_rc_node clustered nats.conf as root (peers: $*)"
    # shellcheck disable=SC2086
    dexec "$_rc_node" -- tether cluster reconcile nats --manual --secrets-dir /etc/tether/secrets \
        --server-name "$_rc_node" --route-url "nats://$_rc_node:6222" \
        --account-issuer "$_rc_acct" --broker-nkey "$_rc_brk" $_rc_peers --conf /etc/tether/nats.conf \
        || die "grow: reconcile $_rc_node failed"
    dexec "$_rc_node" -- nats-server -t -c /etc/tether/nats.conf >/dev/null 2>&1 || die "grow: $_rc_node nats.conf failed -t"
}

# grow <joiner> : add a broker as a voter, running tether's REAL grow commands + the DOCUMENTED runbook
# manual steps, LABELING every step [env] (sim provisioning) / [tether] (a real tether command) /
# [workaround #N] (the sim doing tether's job by hand because tether can't) / [GAP #N] (a defect surfaced
# live) — NOT smoothing tether's gaps into a silent success (sim Mandate; plan
# docs/reviews/simcluster-grow-honest-plan.md). The gaps are ASSERTED by their real signatures in
# drills/{11-grow-gaps (#8/#I1 + full trailer set), 13-inbroker-reconcile-perm (#22)}.sh. Grow still reaches
# VOTER (option B) so the other drills can run; every expected-to-fail attempt is captured, never `|| die`.
# It ends by printing a `GREW-VIA-WORKAROUNDS: …` trailer listing which tether gaps it had to hand-fix.
cmd_grow() {
    _j=${1:?joiner broker node}
    [ "$(role_of "$_j")" = broker ] || die "grow: $_j is not a broker"
    node_running "$_j" || die "grow: $_j container not running"
    _L=$(leader_node) || die "grow: no leader — init a broker first"
    [ "$_L" != "$_j" ] || die "grow: $_j is already the leader"
    log "grow: join $_j → cluster (leader=$_L)"
    _gaps="#I1"   # every grow relies on the joiner running `cluster init` — `join` does NOT bootstrap the
                  # joiner's raft state, and the runbook §1 joiner path omits it (I1, proven on the server).

    log "grow: [env] mint + distribute secrets for $_j (route/tunnel leaves carry a SAN — works around [GAP #24])"
    secrets_mint_node "$INSTANCE" "$_j"
    secrets_distribute "$INSTANCE" "$_j"
    _jpub=$(secrets_node_ident_pub "$INSTANCE" "$_j")
    _gaps="$_gaps,#24"   # minting SAN-bearing route/tunnel certs works around #24 (tether has no cert tooling)

    # [env] a fresh broker runs standalone first (creating its tether.db) — exactly as an operator
    # provisions a new broker host before joining it.
    if ! dexec "$_j" -- test -f /var/lib/tether/tether.db; then
        log "grow: [env] $_j — standalone boot to create tether.db"
        cmd_start_broker "$_j"
        poll_until 20 1 "tether.db on $_j" -- dexec "$_j" -- test -f /var/lib/tether/tether.db || die "grow: $_j tether.db never appeared"
    fi
    sctl "$_j" stop tether-broker 2>/dev/null || true

    # [tether] REQUIRED: cluster-mode `serve` hard-refuses to start without pre-existing raft state
    # (internal/broker/cutover.go:60 "the daemon never auto-bootstraps a cluster onto a live DB"), so the
    # joiner MUST `cluster init --from-existing` to bootstrap raft/ before it can serve — proven on the
    # server (I1). The pty feed is [GAP #5] (init has no machine-escape confirm).
    log "grow: [tether] cluster init --from-existing on $_j (REQUIRED — join does not bootstrap raft/; pty=[GAP #5])"
    dexec -u tether "$_j" -- python3 /opt/sim/pty-confirm.py "$_j" -- \
        tether cluster init --from-existing --self-id "$_j" --name "$_j" \
          --data-dir /var/lib/tether --db /var/lib/tether/tether.db \
          --secrets-dir /etc/tether/secrets --node-ident-pub "$_jpub" \
          --raft-addr "$_j:7400" --nats-route "nats://$_j:6222" \
          --tunnel-addr "$_j:7000" --public-host "$_j" >/dev/null 2>&1 || die "grow: $_j init failed"
    _gaps="$_gaps,#5"   # init has no machine-escape confirm → must fake a TTY via pty-confirm.py

    # [workaround: cluster init PRINTS the broker.yaml cluster seam as its NEXT step 3 but does NOT apply
    # it — the operator/sim must set broker.cluster.{data_dir,raft_addr,secrets_dir} by hand (cluster.go:808).
    # A real `cluster init` that emitted the seam would drop this step.] serve boots cluster mode from raft/.
    dexec "$_j" -- sh -c "grep -qE '^    raft_addr:' /etc/tether/broker.yaml || printf '  cluster:\n    data_dir: /var/lib/tether\n    raft_addr: %s:7400\n    secrets_dir: /etc/tether/secrets\n    nats_conf_path: /etc/tether/nats.conf\n    nats_server_bin: nats-server\n' '$_j' >> /etc/tether/broker.yaml"

    log "grow: [tether] cluster join prepare on $_j (offline, self-signed bundle)"
    # the bundle is a single "tether-join:v1:<base64>" line on stdout (the "run on the LEADER" hint
    # goes to stderr). grep the tether-join: line (it contains colons, so no naive base64 charset match).
    _bundle=$(dexec -u tether "$_j" -- tether cluster join prepare --node-id "$_j" \
        --raft-addr "$_j:7400" --nats-route "nats://$_j:6222" --tunnel-addr "$_j:7000" \
        --public-host "$_j" --secrets-dir /etc/tether/secrets 2>/dev/null | tr -d '\r' | grep -E '^tether-join:' | tail -1)
    [ -n "$_bundle" ] || die "grow: join prepare produced no bundle"

    # [tether] approve with tether's OWN bounded --wait, which SURFACES #8 live. 30s < the 2-min catch-up
    # deadline, so the op is still CATCHING_UP and the CLI prints the stable give-up line
    # `operation <id> still in flight (<state>) after 30s` (cluster_join.go:197, exit 75) — that IS the #8
    # surface: catch-up cannot complete before the NATS mesh + joiner nats exist (chicken-and-egg with the
    # runbook order). The op is STAGED regardless (the leader controller `driveJoin` promotes it once the
    # mesh forms), so we do NOT re-approve — a second approve is a silent idempotent no-op, and after the
    # op turns terminal it is refused as a consumed nonce. The un-bounded `--wait` hangs ~20min (old bug).
    log "grow: [tether] cluster join approve on leader $_L (--wait --timeout 30s; expect the #8 pre-mesh stall)"
    _appr=$(dexec -u tether "$_L" -- tether cluster join approve "$_bundle" --wait --timeout 30s 2>&1) || true
    # waitForOp emits ONLY 'still in flight (<state>) after <t>' (timeout, cluster_join.go:197) or 'is
    # BLOCKED (…)' (stalled, :194) on the non-terminal paths — NOT 'catch-up exceeded' (not a CLI string).
    # Terminal success is 'operation <id> reached <state>' (:187); the always-printed '(driving to SERVING)'
    # preamble is NOT a success signal, so we must not key the success branch on 'SERVING'.
    if printf '%s' "$_appr" | grep -qiE 'still in flight|is BLOCKED'; then
        # echo tether's OWN give-up line (not just the sim label) so a drill can key on the REAL string.
        log "grow: [GAP #8] join approve --wait could not complete pre-mesh (bounded 30s) — op is staged, proceeding. tether said: $(printf '%s' "$_appr" | grep -iE 'still in flight|is BLOCKED' | tail -1)"
        _gaps="$_gaps,#8"
    elif printf '%s' "$_appr" | grep -qiE 'operation .* reached|is now a VOTER|^approved'; then
        log "grow: join approve reached a terminal state before the timeout (mesh may have been pre-formed) — no #8 this run"
    else
        warn "grow: join approve --wait unexpected output (proceeding; the op may still be staged): $(printf '%s' "$_appr" | tr '\n' ' ' | tail -c 200)"
    fi

    # [workaround #10] Every broker must be CLUSTERED + routed to every OTHER (full mesh) BEFORE the joiner
    # broker starts, so the clustered JS meta forms at quorum ⌈(N+1)/2⌉ — else the joiner boots
    # clustered-but-alone and hits the N=1-clustered-JS trap (#10, exit-70 crash-loop). This precise
    # ordering (mesh-then-start-joiner) exists ONLY to dodge #10; a real `tether cluster add` would own it.
    # The per-broker render itself is [workaround #22/#3] (see _reconcile_clustered). #10 is labeled +
    # trailer-named (11-grow-gaps asserts the trailer set); a dedicated clustered-alone-exit-70 probe is deferred.
    # NB: guard every command-substitution against `set -e`/`pipefail` (an unguarded `grep -c` that finds
    # nothing, or a transient empty status, would silently kill grow right here — the first-cut bug).
    _acct=$(secrets_account_pub "$INSTANCE" || true)
    [ -n "$_acct" ] || die "grow: could not derive account pub (check secrets)"
    # existing voters (before this join) — poll briefly so a transient status read can't yield empty.
    _voters=""
    _pv_end=$(( $(date +%s) + 20 ))
    while :; do
        _voters=$(cluster_status_json "$_L" 2>/dev/null | jq -r '.nodes[]? | select(.phase=="VOTER") | (.node_id//.id//.name)' 2>/dev/null || true)
        [ -n "$_voters" ] && break
        [ "$(date +%s)" -ge "$_pv_end" ] && break
        sleep 1
    done
    [ -n "$_voters" ] || die "grow: no existing VOTER found in leader status"
    _n_before=$(printf '%s\n' "$_voters" | grep -c . || true); _n_before=${_n_before:-1}

    # [tether] FIRST attempt the operator's ONE-command mesh render, so the failure it works around is ON
    # THE RECORD (Mandate ②: expose the gap, don't just narrate it) — and so the #3/#22 trailer token is
    # generated from an OBSERVED failure, not a static ordinal guess (external-review F1: an ordinal-only
    # token false-greens if the product fixes the auto path). It cannot auto-converge: first grow → the
    # former-N1 conf is standalone so the in-broker reconciler can't harvest route mTLS (#3); later grows →
    # it perm-denies the /etc/tether write (#22). Capture the real 'timed out … not converged' string + the
    # laggard's topo_reconcile_reason. If it EVER converges (exit 0), the auto path is FIXED → we do NOT add
    # #3/#22 to the trailer → 11-grow-gaps flips (the honest promote-signal).
    log "grow: [tether] attempt reconcile nats --all --wait --timeout 25s (expect it can't auto-converge → #3 first grow / #22 later)"
    _all=$(dexec -u tether "$_L" -- tether cluster reconcile nats --all --wait --timeout 25s 2>&1) || true
    _allfailed=0
    if printf '%s' "$_all" | grep -qiE 'timed out.*not converged|not converged|no cluster.{0,4}block to harvest|permission denied'; then
        _allfailed=1
        _allreason=$(cluster_status_json "$_L" 2>/dev/null | jq -r '[.nodes[]?|.topo_reconcile_reason//empty]|map(select(.!=""))|first//""' 2>/dev/null || true)
        if [ "$_n_before" -ge 2 ]; then
            log "grow: [GAP #22] reconcile nats --all could not auto-converge (in-broker reconciler perm-denied /etc/tether) — hand-render required. tether: $(printf '%s' "$_all" | grep -iE 'timed out|not converged|permission' | tail -1) | reason: ${_allreason:-?}"
        else
            log "grow: [GAP #3] reconcile nats --all could not harvest route mTLS from the standalone conf — hand-render required. tether: $(printf '%s' "$_all" | grep -iE 'timed out|not converged|harvest' | tail -1) | reason: ${_allreason:-?}"
        fi
    else
        log "grow: reconcile nats --all did NOT fail as expected (auto path may be fixed): $(printf '%s' "$_all" | tr '\n' ' ' | tail -c 160)"
    fi

    log "grow: [workaround #10] render full route mesh on all brokers BEFORE starting the joiner (dodges the #10 clustered-alone trap)"
    _allnodes=$(printf '%s\n%s' "$_voters" "$_j")
    for _node in $_allnodes; do
        _peers=""
        for _p in $_allnodes; do [ "$_p" != "$_node" ] && _peers="$_peers $(peer_triple "$INSTANCE" "$_p")"; done
        # shellcheck disable=SC2086
        _reconcile_clustered "$_node" "$(secrets_broker_pub "$INSTANCE" "$_node")" "$_acct" $_peers
    done
    # mesh-before-joiner ordering dodges #10 (always). The hand-render works around the BROKEN auto path,
    # whose blocker is grow-ordinal-specific + MUTUALLY EXCLUSIVE (plan §0): first grow → the former-N1
    # conf is standalone → `reconcile nats --all` can't harvest route mTLS (#3); later grows → conf already
    # clustered → the in-broker reconciler perm-denies the /etc/tether write (#22). #3 is added on the first
    # grow below (with #4); add #22 only on later grows so the trailer is never self-contradictory (#3+#22).
    _gaps="$_gaps,#10"
    # #22 (later grows) only when the --all attempt ACTUALLY failed above (observed, not an ordinal guess) —
    # so a product fix to the auto path drops the token → 11-grow-gaps flips (external-review F1).
    [ "$_n_before" -ge 2 ] && [ "${_allfailed:-0}" = 1 ] && _gaps="$_gaps,#22"

    _fn1=""
    if [ "$_n_before" = 1 ]; then
        _fn1=$(printf '%s\n' "$_voters" | head -1)
        # [workaround #4] standalone JS does not migrate into the clustered meta; the former-N1's store
        # must be reset (tether should auto reset / backup+restore). #4 is labeled + trailer-named (dedicated orphan-stream probe deferred).
        log "grow: [workaround #4] reset former-N1 JS store ($_fn1) — standalone JS does not migrate into the clustered meta"
        sctl "$_fn1" stop nats-server
        dexec "$_fn1" -- sh -c 'mv /var/lib/tether/jetstream /var/lib/tether/jetstream.grow-bak.$(date +%s) 2>/dev/null || true'
        sctl "$_fn1" start nats-server
        # [workaround #23] the former-N1's tether-broker was RUNNING (it is the leader) when its nats was
        # stopped for the JS reset — exactly the #23 hazard (clean-exit on nats loss + Restart=on-failure →
        # stays inactive). Idempotently (re)start it; we VERIFY recovery at the END (polling NOW races the
        # not-yet-formed JS meta #10 and false-dies). reset-failed FIRST (mirror the post-poll recovery):
        # the crash-loop during the nats-down window can trip systemd StartLimitBurst → a bare `start` is
        # REFUSED → the leader's driveJoin stays dead → the joiner never reaches VOTER (deadlock: joiner
        # waits for leader, leader recovery is gated inside the VOTER-success branch below). #23 defer: no
        # deterministic RED drill (its clean-exit trigger is unlocated; grow labels + recovers it).
        dexec "$_fn1" -- systemctl reset-failed tether-broker 2>/dev/null || true
        sctl "$_fn1" start tether-broker 2>/dev/null || true
        _gaps="$_gaps,#4"
        # #3 (first grow) only when the --all attempt ACTUALLY failed to harvest (observed) — drops the
        # token if the product fixes the standalone-conf harvest path → 11-grow-gaps flips (external-review F1).
        [ "${_allfailed:-0}" = 1 ] && _gaps="$_gaps,#3"
    fi

    # [workaround #23/#10] reload already-running voters' nats via SIGHUP to pick up the new route. The
    # DOCUMENTED runbook step (cluster-runbook.md §1) is `systemctl restart nats-server`, but a restart
    # clean-exits the running tether-broker (#23; Restart=on-failure won't revive it) AND bounces an
    # in-mesh voter back to CATCHING_UP (#10). SIGHUP dodges BOTH — it is the sim doing tether's job (a
    # real `cluster add` would manage the reload), NOT neutral ops. (Downside: SIGHUP does not advance
    # /varz config_load_time, so the health label lingers DEGRADED-WRITABLE though routes/JS converge.)
    log "grow: [workaround #23/#10] SIGHUP-reload existing voters' nats (restart would trip #23/#10) + start $_j nats"
    for _node in $_voters; do
        [ "$_node" = "$_fn1" ] && continue   # former-N1 already stop/reset/started above
        dexec "$_node" -- sh -c 'pkill -HUP -x nats-server' 2>/dev/null || sctl "$_node" reload nats-server 2>/dev/null || true
    done
    case "$_gaps" in *"#23"*) ;; *) _gaps="$_gaps,#23" ;; esac
    sctl "$_j" restart nats-server

    log "grow: [tether] start $_j tether-broker in cluster mode (JS now available) → catch up"
    sctl "$_j" start tether-broker

    if poll_until 150 3 "$_j reaches VOTER" -- _phase_is "$_j" VOTER; then
        # [workaround #23] NOW that the joiner is a VOTER and the JS meta has re-formed, recover the
        # former-N1's tether-broker — it can clean-exit on the JS-reset nats restart (#23) AND crash-loop
        # (exit 70) in the window before the meta forms (#10). reset-failed clears the StartLimit, start
        # brings it up only if inactive (no leadership blip if it survived). Never `restart` (re-election).
        if [ -n "$_fn1" ]; then
            dexec "$_fn1" -- systemctl reset-failed tether-broker 2>/dev/null || true
            sctl "$_fn1" start tether-broker 2>/dev/null || true
            poll_until 90 3 "$_fn1 tether-broker recovered after JS reset" -- _broker_up "$_fn1" \
                || die "grow: former-N1 $_fn1 tether-broker did not recover after its nats reset (gotcha #23)"
        fi
        ok "grow: $_j is now a VOTER (cluster=$(list_nodes broker | tr '\n' ' '))"
        # Mandate ④: grow reached VOTER, but ONLY via the hand-fixes above — emit a machine-parseable
        # trailer naming exactly which tether gaps it had to work around, so the smoothness can never be
        # consumed as if it were a clean `tether cluster add`. 11-grow-gaps.sh asserts this trailer is
        # present; the day a real fix removes a workaround, the list changes and the assertion flips.
        printf 'GREW-VIA-WORKAROUNDS: %s\n' "$_gaps"
    else
        err "grow: $_j did not reach VOTER — check: ./simcluster status ; ./simcluster logs $_j tether-broker"
        printf 'GREW-VIA-WORKAROUNDS: %s (INCOMPLETE — did not reach VOTER)\n' "$_gaps"
        return 1
    fi
}

# init <brk> : cut a standalone broker over to an N=1 cluster (§4.1). Mints+distributes secrets,
# runs cluster init --from-existing (pty-fed typed confirm), executes init's printed reconcile
# step verbatim (pubkeys pre-substituted from secrets), enables cluster mode in broker.yaml.
cmd_init() {
    _n=${1:?broker node}
    [ "$(role_of "$_n")" = broker ] || die "init: $_n is not a broker"
    node_running "$_n" || die "init: $_n container not running"

    log "init: mint + distribute secrets for $_n"
    secrets_mint_node "$INSTANCE" "$_n"
    secrets_distribute "$INSTANCE" "$_n"
    _pub=$(secrets_node_ident_pub "$INSTANCE" "$_n")
    [ -n "$_pub" ] || die "init: could not derive node-ident pub (check vendor/nk)"

    # init --from-existing migrates an EXISTING tether.db; ensure the broker has run once to create it.
    if ! dexec "$_n" -- test -f /var/lib/tether/tether.db; then
        log "init: no tether.db yet — starting standalone once to create it"
        cmd_start_broker "$_n"
        poll_until 20 1 "tether.db created" -- dexec "$_n" -- test -f /var/lib/tether/tether.db || die "init: tether.db never appeared"
    fi

    log "init: stop tether-broker for offline cutover"
    sctl "$_n" stop tether-broker 2>/dev/null || true

    log "init: cluster init --from-existing (pty-fed typed confirm)"
    _out=$(dexec -u tether "$_n" -- python3 /opt/sim/pty-confirm.py "$_n" -- \
        tether cluster init --from-existing --self-id "$_n" --name "$_n" \
          --data-dir /var/lib/tether --db /var/lib/tether/tether.db \
          --secrets-dir /etc/tether/secrets --node-ident-pub "$_pub" \
          --raft-addr "$_n:7400" --nats-route "nats://$_n:6222" \
          --tunnel-addr "$_n:7000" --public-host "$_n" 2>&1) || { printf '%s\n' "$_out" >&2; die "init: cluster init failed"; }
    printf '%s\n' "$_out"

    # run init's printed step-1 reconcile verbatim (account-issuer/broker-nkey pre-filled from secrets).
    # tr -d '\r' is LOAD-BEARING: pty-confirm.py runs init under a pty (cooked mode → \n becomes \r\n),
    # so a naive extraction captures a trailing \r into the last arg (--broker-nkey), which reconcile
    # writes into nats.conf verbatim (nkey"…\r") → every NATS auth_callout CONNECT then mismatches and
    # the broker crash-loops "NATS connect: i/o timeout". Strip CRs from the whole captured output.
    _out=$(printf '%s' "$_out" | tr -d '\r')
    _recon=$(printf '%s\n' "$_out" | sed -n 's/^ *1\. tether //p' | head -1)
    [ -n "$_recon" ] || die "init: could not extract the reconcile step from init output"
    log "init: manual nats.conf cutover: tether $_recon"
    # reconcile writes /etc/tether/nats.conf as root (install.sh leaves it root:root 0644; the takeover
    # preserves 0644). We do NOT chown it (Mandate ①): nats-server (User=tether) reads the world-readable
    # root-owned conf fine, and the root-owned /etc/tether DIRECTORY stays as install.sh made it so the
    # in-broker reconciler's #22 perm-denial is faithfully reproduced (never masked by a chown).
    # shellcheck disable=SC2086
    dexec "$_n" -- tether $_recon || die "init: reconcile nats failed"

    log "init: validate nats.conf (-t) + restart nats-server"
    dexec "$_n" -- nats-server -t -c /etc/tether/nats.conf >/dev/null 2>&1 || die "init: nats.conf failed nats-server -t validation"
    sctl "$_n" restart nats-server

    log "init: enable cluster mode in broker.yaml"
    dexec "$_n" -- sh -c "grep -qE '^    raft_addr:' /etc/tether/broker.yaml || printf '  cluster:\n    data_dir: /var/lib/tether\n    raft_addr: %s:7400\n    secrets_dir: /etc/tether/secrets\n    nats_conf_path: /etc/tether/nats.conf\n    nats_server_bin: nats-server\n' '$_n' >> /etc/tether/broker.yaml"

    log "init: start tether-broker in cluster mode"
    sctl "$_n" start tether-broker

    if poll_until 90 3 "N=1 leader elected" -- _has_leader; then
        ok "init: $_n is a single-voter cluster (leader=$(leader_node))"
    else
        err "init: no leader after 90s — check: ./simcluster logs $_n tether-broker"
        return 1
    fi
}

# session <name> --pin <pin> [--broker <brk>] : create a session + activate it on the ctl node.
cmd_session() {
    _name=${1:?session name}; shift
    _pin=""; _brk=""
    while [ $# -gt 0 ]; do case "$1" in
        --pin) _pin=$2; shift 2;; --broker) _brk=$2; shift 2;; *) die "session: unknown arg $1";;
    esac; done
    [ -n "$_pin" ] || die "session: --pin required"
    [ -n "$_brk" ] || _brk=$(list_nodes broker | head -1)
    _ctl=$(list_nodes ctl | head -1); [ -n "$_ctl" ] || die "session: no ctl node (up --ctl 1)"
    _url="nats://$_brk:4222"
    log "session: create '$_name' + ctl login on $_ctl (broker=$_url)"
    dexec -u sim "$_ctl" -- env HOME=/home/sim tether session create "$_name" --pin "$_pin" --nats-url "$_url" || die "session create failed"
    dexec -u sim "$_ctl" -- env HOME=/home/sim tether login -s "$_name" --pin "$_pin" --nats-url "$_url" || die "ctl login failed"
    ok "session '$_name' created + ctl activated"
}

# ctl -- <tether args...> : run the tether CLI from the ctl container (HOME=/home/sim keeps its
# persisted session + broker_url from `session`).
cmd_ctl() {
    [ "${1:-}" = "--" ] && shift
    _ctl=$(list_nodes ctl | head -1); [ -n "$_ctl" ] || die "ctl: no ctl node (up --ctl 1)"
    dexec -u sim "$_ctl" -- env HOME=/home/sim tether "$@"
}

# agent-join <agt> --session <sid> --pin <pin> [--broker <brk>] : bind the agent nkey (first --pin
# connect), then install + start a persistent tether-agent unit that reconnects as a bound member.
cmd_agent_join() {
    _agt=${1:?agent node}; shift
    _sid=lab; _pin=""; _brk=""
    while [ $# -gt 0 ]; do case "$1" in
        --session) _sid=$2; shift 2;; --pin) _pin=$2; shift 2;; --broker) _brk=$2; shift 2;; *) die "agent-join: unknown arg $1";;
    esac; done
    [ -n "$_pin" ] || die "agent-join: --pin required"
    [ -n "$_brk" ] || _brk=$(list_nodes broker | head -1)
    _url="nats://$_brk:4222"
    log "agent-join: bind $_agt → session $_sid (broker=$_url)"
    # first --pin connect binds the agent nkey as a session member + persists it to /home/sim/.tether.
    dexec -u sim "$_agt" -- sh -c "HOME=/home/sim timeout 6 tether agent --session '$_sid' --nid '$_agt' --pin '$_pin' --nats-url '$_url' >/tmp/agent-bind.log 2>&1 || true"
    # persistent unit (reconnects as the now-bound member; no PIN in argv).
    dexec "$_agt" -- sh -c "printf 'SID=%s\nNID=%s\nNATS_URL=%s\n' '$_sid' '$_agt' '$_url' > /etc/tether/agent.env
cat > /etc/systemd/system/tether-agent.service <<UNIT
[Unit]
Description=tether agent (sim)
After=network-online.target
[Service]
Type=simple
User=sim
Environment=HOME=/home/sim
EnvironmentFile=/etc/tether/agent.env
ExecStart=/usr/local/bin/tether agent --session \\\${SID} --nid \\\${NID} --nats-url \\\${NATS_URL}
Restart=on-failure
RestartSec=2
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload"
    sctl "$_agt" enable --now tether-agent
    # M3: the unit is Type=simple, so `enable --now` returns 0 the instant the process is exec'd — BEFORE
    # it binds/registers. Verify by RESULT: poll the roster until the agent is ONLINE before claiming ok.
    if poll_until 40 3 "$_agt ONLINE in roster" -- _agent_online "$_agt"; then
        ok "agent-join: $_agt onboarded + ONLINE"
    else
        die "agent-join: $_agt did not reach ONLINE (check: ./simcluster logs $_agt tether-agent)"
    fi
}

# _agent_online <agt> : predicate — the agent is ONLINE in the ctl's `node ls` (needs an active session).
_agent_online() {
    _ao_ctl=$(list_nodes ctl | head -1); [ -n "$_ao_ctl" ] || return 1
    dexec -u sim "$_ao_ctl" -- env HOME=/home/sim tether node ls 2>/dev/null | grep -qE "^$1[[:space:]].*ONLINE"
}

# force-single <survivor> --dead <n>[,<n>] : online quorum-loss escape (§4.3, the #20/#12 setup).
# docker-kills the dead peer(s), waits for their ports to refuse + the quorum-loss dwell, then drives
# `cluster recovery force-single --online` (pty-fed). DELIBERATELY does NOT restart the survivor's
# nats-server — the whole point of #20 is that force-single leaves nats.conf clustered and the running
# nats-server keeps the stale 2-node config → JetStream 503-rots.
cmd_force_single() {
    _s=${1:?survivor}; shift
    _dead=""
    while [ $# -gt 0 ]; do case "$1" in --dead) _dead=$2; shift 2;; *) die "force-single: unknown arg $1";; esac; done
    [ -n "$_dead" ] || die "force-single: --dead <node>[,<node>] required"
    log "force-single: docker-kill dead peer(s) [$_dead] (survivor=$_s)"
    for _d in $(printf '%s' "$_dead" | tr ',' ' '); do run d kill "$(ctr_name "$_d")" >/dev/null 2>&1 || true; done
    for _d in $(printf '%s' "$_dead" | tr ',' ' '); do
        poll_until 30 2 "$_d :7400 connection-refused" -- tcp_refused "$_d" 7400 || warn "force-single: $_d :7400 not confirmed refused"
    done
    # The broker requires a CONTINUOUS ~15s quorum-loss dwell before it accepts force-single, and its
    # dwell timer starts when IT detects quorum loss (later than our kill), so a fixed sleep races it.
    # Poll the zero-mutation --dry-run gate (no confirm needed) until it would proceed.
    log "force-single: waiting for the continuous-quorum-loss dwell (polling the --dry-run gate)"
    poll_until 60 3 "quorum-loss dwell satisfied" -- \
        dexec -u tether "$_s" -- tether cluster recovery force-single --online --dry-run \
          --self-id "$_s" --self-addr "$_s:7400" --confirm-peers-dead "$_dead" \
        || die "force-single: dwell gate never satisfied within 60s"
    log "force-single: cluster recovery force-single --online on $_s (pty-fed typed confirm)"
    # The online command can exit non-zero even when the escape COMMITTED (post-commit advisories), so
    # verify by RESULT (the survivor entered force-single mode), not by the command's exit code.
    dexec -u tether "$_s" -- python3 /opt/sim/pty-confirm.py "$_s" -- \
        tether cluster recovery force-single --online --self-id "$_s" \
          --self-addr "$_s:7400" --confirm-peers-dead "$_dead" 2>&1 | tail -6 || true
    if poll_until 30 3 "$_s entered force-single mode" -- _forced_single "$_s"; then
        ok "force-single: $_s is now a lone N=1 survivor (nats.conf deliberately NOT touched — the #20 setup)"
    else
        die "force-single: $_s did not enter force-single mode"
    fi
}

# _forced_single <survivor> : predicate — the survivor reports force-single mode. Capture first (|| true):
# `status` exits non-zero under force-single, which pipefail would propagate past a matching jq.
_forced_single() {
    _fs_out=$(dexec -u tether "$1" -- tether cluster status --json 2>/dev/null || true)
    printf '%s' "$_fs_out" | jq -e '.force_single==true or .health=="FORCE_SINGLE" or (.health_label|test("FORCE.?SINGLE";"i"))' >/dev/null 2>&1
}

cmd_exec()  { _n=${1:?node}; shift; [ "${1:-}" = "--" ] && shift; dexec "$_n" -- "$@"; }
cmd_shell() { dexec_it "${1:?node}" -- bash; }
cmd_logs()  { _n=${1:?node}; _u=${2:-}; if [ -n "$_u" ]; then dexec "$_n" -- journalctl -u "$_u" --no-pager -n 200; else dexec "$_n" -- journalctl --no-pager -n 200; fi; }
cmd_natsconf() { _n=${1:?node}; dexec "$_n" -- sh -c 'echo "--- /etc/tether/nats.conf ($(stat -c %y /etc/tether/nats.conf 2>/dev/null)) ---"; grep -nE "cluster|route|host|jetstream" /etc/tether/nats.conf 2>/dev/null || echo "(no nats.conf)"'; }

cmd_status() {
    # F4 / round-2 R1: `--json` is the documented machine surface — it must emit the AUTHORITATIVE LEADER
    # report, not whatever broker sorts first (a follower returns is_leader_view=false with best-effort
    # reachability — useless for orchestration). Resolve .leader_id, query that broker, and FAIL CLOSED
    # (error JSON) unless the report is is_leader_view=true.
    if [ "${1:-}" = "--json" ]; then
        _sl=$(leader_node) || { printf '{"error":"no leader in instance %s"}\n' "$INSTANCE"; return 1; }
        _j=$(dexec -u tether "$_sl" -- tether cluster status --json 2>/dev/null || true)
        if printf '%s' "$_j" | jq -e '.is_leader_view==true' >/dev/null 2>&1; then
            printf '%s\n' "$_j"; return 0
        fi
        printf '{"error":"leader %s did not return an authoritative (is_leader_view) report in instance %s"}\n' "$_sl" "$INSTANCE"; return 1
    fi
    printf '%-10s %-8s %-9s %s\n' NODE ROLE RUNNING CONTAINER
    for n in $(list_nodes); do
        [ -n "$n" ] || continue
        printf '%-10s %-8s %-9s %s\n' "$n" "$(role_of "$n")" \
            "$(node_running "$n" && echo yes || echo no)" "$(ctr_name "$n")"
    done
    # leader/cluster view once a cluster exists (best-effort).
    for n in $(list_nodes broker); do
        if node_running "$n"; then
            _j=$(dexec -u tether "$n" -- tether cluster status --json 2>/dev/null || true)
            [ -n "$_j" ] && { echo "--- cluster status (via $n) ---"; echo "$_j" | jq -C . 2>/dev/null || echo "$_j"; break; }
        fi
    done
}

cmd_ssh() {
    _n=${1:?node}
    _ip=$(d inspect -f "{{(index .NetworkSettings.Networks \"$(net_name)\").IPAddress}}" "$(ctr_name "$_n")")
    [ -n "$_ip" ] || die "no IP for $_n"
    log "ssh sim@$_ip ($_n) — password 'sim' or your key"
    exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "sim@$_ip"
}

cmd_down() {
    for n in $(list_nodes); do [ -n "$n" ] && run d stop "$(ctr_name "$n")" >/dev/null 2>&1 || true; done
    if [ "${1:-}" = "-v" ]; then for n in $(list_nodes); do rm_node "$n" --vols; done; d network rm "$(net_name)" >/dev/null 2>&1 || true; fi
    ok "down (instance=$INSTANCE${1:+ , volumes removed})"
}

cmd_nuke() {
    for n in $(list_nodes); do [ -n "$n" ] && rm_node "$n" --vols; done
    d network rm "$(net_name)" >/dev/null 2>&1 || true
    rm -rf "${SECRETS_STASH:-$HERE/secrets}/$INSTANCE" 2>/dev/null || true
    ok "nuked instance=$INSTANCE (containers + volumes + secrets stash)"
}

# drill <name> : run drills/<name>.sh on an isolated throwaway --instance; print RED/GREEN.
cmd_drill() {
    _name=${1:?drill name}; shift 2>/dev/null || true
    _script="$HERE/drills/$_name.sh"
    [ -f "$_script" ] || die "drill: no such drill '$_name' ($_script)"
    _inst="drill-$_name"
    log "drill: $_name on isolated instance '$_inst'"
    # M4: under `set -e` a RED/failed drill would abort cmd_drill BEFORE teardown → leaked instance.
    # Guard with `|| _rc=$?` and an INT/TERM trap so the throwaway instance is always reaped.
    _rc=0
    trap 'env INSTANCE="$_inst" "$HERE/simcluster" nuke >/dev/null 2>&1 || true; exit 130' INT TERM
    env INSTANCE="$_inst" SIM="$HERE/simcluster" HERE="$HERE" IMAGE="$IMAGE" sh "$_script" || _rc=$?
    trap - INT TERM
    if [ "${SIM_KEEP:-0}" = 1 ]; then
        warn "drill: SIM_KEEP=1 — leaving instance '$_inst' up for inspection (nuke: INSTANCE=$_inst ./simcluster nuke)"
    else
        env INSTANCE="$_inst" "$HERE/simcluster" nuke >/dev/null 2>&1 || true
    fi
    return $_rc
}

cmd_doctor() {
    log "doctor: PID1 + provisioning + drift checks (instance=$INSTANCE)"
    _dr_rc=0
    for n in $(list_nodes); do
        node_running "$n" || { warn "$n not running"; continue; }
        _s=$(dexec "$n" -- systemctl is-system-running 2>/dev/null || true)
        case "$_s" in running|degraded) ok "$n systemd: $_s";; *) err "$n systemd: ${_s:-dead}"; _dr_rc=1;; esac
    done
    for b in $(list_nodes broker); do
        node_running "$b" || continue
        # #22 tripwire (M6, INVERTED): install.sh leaves /etc/tether ROOT-owned → a User=tether nats.conf
        # write (the in-broker C3 reconciler's path) perm-denies its atomic temp/.bak write. Root-owned is
        # the #22 PRECONDITION, not an error. If /etc/tether is tether-owned, the sim is MASKING #22 (an
        # earlier build once baked a masking chown) and can no longer regression-detect it — warn loudly.
        if [ "$(dexec "$b" -- stat -c %U /etc/tether 2>/dev/null)" = tether ]; then
            warn "$b /etc/tether is tether-owned — this MASKS gotcha #22 (leave it root-owned to reproduce it)"
        else
            ok "$b /etc/tether root-owned — #22 precondition holds (a User=tether reconcile write would perm-deny; drill 13 exercises it)"
        fi
        # symmetric artifact guard: /var/lib/tether MUST be tether-owned (install.sh chowns LIB to tether;
        # the broker User=tether writes DB/JS/raft there). If a docker/install change flipped it to root,
        # the broker would be bricked as a SIM ARTIFACT (not a tether bug) — catch it, don't misattribute.
        if [ "$(dexec "$b" -- stat -c %U /var/lib/tether 2>/dev/null)" != tether ]; then
            err "$b /var/lib/tether is NOT tether-owned — sim artifact would brick the broker (install.sh chowns LIB to tether)"; _dr_rc=1
        fi
        # #21/OQ-5 guard: max_file_store as a jetstream subkey bricks `reconcile nats` (use a tmpfs cap).
        if dexec "$b" -- grep -q max_file_store /etc/tether/nats.conf 2>/dev/null; then
            err "$b nats.conf has max_file_store — bricks reconcile (use --cap-store tmpfs, #21/OQ-5)"; _dr_rc=1
        fi
        # units laid down by the REAL install.sh (drift tripwire: presence — a forked provisioner would miss them).
        for u in nats-server tether-broker; do
            dexec "$b" -- test -f "/etc/systemd/system/$u.service" || { err "$b missing unit $u.service (install.sh drift?)"; _dr_rc=1; }
        done
    done
    [ "$_dr_rc" = 0 ] && ok "doctor: clean" || err "doctor: issues found"
    return $_dr_rc
}

usage() {
    cat >&2 <<EOF
simcluster — docker simulated-cluster dev tool (instance=\$INSTANCE, image=\$IMAGE)
  build                         build the tether-sim image from vendor/ + install.sh
  up --brokers N --agents M --ctl 1   create + boot + provision nodes (does not cluster)
  start-broker <brk>            enable+start nats-server + tether-broker (standalone)
  init <brk>                    cluster init --from-existing → N=1 cluster        [phase 1, TODO]
  grow <brk>                    fresh-voter join → N+1                            [phase 2, TODO]
  force-single <brk> --dead N   online force-single escape                       [phase 3, TODO]
  status [--json]               node table + leader cluster status
  exec <node> -- <cmd...>       docker exec (robust debug primitive)
  shell <node>                  interactive bash in a node
  ssh <node>                    ssh into a node (real sshd)
  logs <node> [unit]            journalctl inside a node
  nats-conf <node>              inspect /etc/tether/nats.conf (the #20 probe)
  down [-v]                     stop nodes (keep volumes; -v removes them)
  nuke                          remove containers + volumes (clean slate)
  doctor                        PID1 re-smoke + drift checks
EOF
    exit 2
}

# F4: global `--instance <name>` before the verb (documented isolation control; also settable via env
# INSTANCE=). Applies to every verb; the lib helpers read $INSTANCE at call time so setting it here works.
while [ $# -gt 0 ]; do
    case "$1" in
        --instance) INSTANCE=$2; shift 2 ;;
        *) break ;;
    esac
done
[ $# -ge 1 ] || usage
verb=$1; shift
case "$verb" in
    build)         cmd_build "$@";;
    up)            cmd_up "$@";;
    start-broker)  cmd_start_broker "$@";;
    init)          cmd_init "$@";;
    grow)          cmd_grow "$@";;
    force-single)  cmd_force_single "$@";;
    session)       cmd_session "$@";;
    agent-join)    cmd_agent_join "$@";;
    ctl)           cmd_ctl "$@";;
    status)        cmd_status "$@";;
    exec)          cmd_exec "$@";;
    shell)         cmd_shell "$@";;
    ssh)           cmd_ssh "$@";;
    logs)          cmd_logs "$@";;
    nats-conf)     cmd_natsconf "$@";;
    drill)         cmd_drill "$@";;
    down)          cmd_down "$@";;
    nuke)          cmd_nuke "$@";;
    doctor)        cmd_doctor "$@";;
    *)             usage;;
esac
